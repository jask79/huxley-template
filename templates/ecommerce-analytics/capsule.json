  "description": "Analytics and reporting capsule for e-commerce insights",
  "owners": ["{{USER_LOGIN}}"],
  "created_at": "",
  "version": "1.0.0",
  
  "analytics_config": {
    "analysis_type": "performance_report",
    "scope": "brand_level",
    "time_period": {
