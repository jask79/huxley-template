{
  "permissions": {
    "defaultMode": "default"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/tools/hooks/run-hook.sh\" tools/hooks/post_tool_use.py"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/tools/hooks/run-hook.sh\" tools/system-utils/hooks/review_accumulator.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/tools/hooks/run-hook.sh\" tools/orchestrator-validation-hook.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/tools/hooks/run-hook.sh\" tools/system-utils/hooks/review_stop_hook.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/tools/hooks/run-hook.sh\" tools/system-utils/hooks/stop_git_checkpoint.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/tools/hooks/run-hook.sh\" tools/system-utils/hooks/heic-converter.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/tools/hooks/run-hook.sh\" tools/hooks/on_session_end.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/tools/hooks/run-hook.sh\" tools/hooks/simple_capsule_update.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/tools/hooks/run-hook.sh\" tools/system-utils/hooks/export_session_transcript.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
