{
  "name": "catalyst-photoshop-mcp",
  "version": "1.0.0",
  "description": "Huxley MCP server for Adobe Photoshop automation — drives PS via ExtendScript-over-AppleScript with brand templates, batch processing, AI Select Subject, and export presets",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "catalyst-photoshop-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "dev": "tsc && node dist/index.js",
    "start": "node dist/index.js",
    "smoke": "node dist/smoke.js"
  },
  "keywords": [
    "mcp",
    "photoshop",
    "adobe",
    "automation",
    "extendscript",
    "applescript",
    "catalyst",
    "model-context-protocol"
  ],
  "author": "Huxley ({{ORCHESTRATOR_NAME}})",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.25.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
