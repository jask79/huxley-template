{
  "name": "ig-story",
  "description": "Instagram story / Reel cover 1080x1920.",
  "canvas": {
    "width": 1080,
    "height": 1920,
    "dpi": 72,
    "colorMode": "RGB",
    "backgroundColor": [12, 12, 18]
  },
  "layers": [
    {
      "type": "image",
      "source": "{params.background_image}",
      "fit": "fill"
    },
    {
      "type": "text",
      "content": "{params.title}",
      "fontName": "Helvetica-Bold",
      "fontSize": 80,
      "color": [255, 255, 255],
      "alignment": "CENTER",
      "x": 540,
      "y": 1450
    }
  ],
  "export": [
    {
      "preset": "ig-story",
      "filename": "{params.slug}-story"
    }
  ]
}
