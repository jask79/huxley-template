# CartPanda API credentials
# Copy to .env (gitignored) and fill in real values once your CartPanda account is live.
# Account dashboard: https://accounts.cartpanda.com/
# Webhook config:    https://accounts.cartpanda.com/settings/webhooks

# API key / bearer token for authenticating REST calls.
# TODO: Confirm header name (Authorization: Bearer ... vs X-API-Key) once account access is granted.
CARTPANDA_API_KEY=

# Base URL for the V3 API. Falls back to legacy CartX if needed.
# TODO: Confirm exact host once account is live — placeholder below is best-guess from public docs.
CARTPANDA_BASE_URL=https://accounts.cartpanda.com/api/v3

# Shop slug / store identifier. Some CartPanda endpoints are scoped under /shop/{slug}/...
CARTPANDA_SHOP_SLUG=

# Webhook signing secret. CartPanda's exact signing mechanism is not publicly documented
# at scaffold time — see cartpanda/webhook_receiver.py for the verification stub.
CARTPANDA_WEBHOOK_SECRET=

# Local webhook receiver host/port (matches global/config/port-registry.yaml)
CARTPANDA_WEBHOOK_HOST=127.0.0.1
CARTPANDA_WEBHOOK_PORT=3201

# Request behavior
CARTPANDA_TIMEOUT_SECONDS=30
CARTPANDA_MAX_RETRIES=3
CARTPANDA_LOG_LEVEL=INFO
