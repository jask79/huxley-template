# ============================================================================
# Huxley Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual API keys
# IMPORTANT: Never commit .env to git - it contains sensitive credentials
# ============================================================================

# ============================================================================
# Database Configuration
# ============================================================================
# NOTE: Huxley v0.1 ships no docker-compose stack — these keys are read only
# if you add your own Postgres/pgAdmin/Grafana services. The CHANGE_ME values
# are deliberately non-functional: replace them with strong, randomly
# generated passwords before any service starts.
POSTGRES_USER=huxley
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_FIRST_RUN
POSTGRES_DB=huxley

# Database Management UI
PGADMIN_EMAIL=admin@example.local
PGADMIN_PASSWORD=CHANGE_ME_BEFORE_FIRST_RUN

# Monitoring & Observability
GRAFANA_PASSWORD=CHANGE_ME_BEFORE_FIRST_RUN

# ============================================================================
# AI Service API Keys
# ============================================================================
# REQUIRED: Anthropic Claude API (core functionality)
ANTHROPIC_API_KEY=your_anthropic_key_here

# OPTIONAL: OpenRouter API (only if you run the Bifrost/Infinity gateway)
OPENROUTER_API_KEY=your_openrouter_key_here

# OPTIONAL: Fal AI API (only for 📸 Camera Man / media-engine visual generation - Sora 2, Veo 3, image models)
FAL_API_KEY=your_fal_key_here

# OPTIONAL: Google Gemini API (media generation tools: the nano-banana skill,
# media-engine image workflows, and 📸 Camera Man's image/video generation)
GEMINI_API_KEY=your_gemini_key_here

# OPTIONAL: Additional AI providers (uncomment if needed)
GROQ_API_KEY=your_groq_key_here
FIREWORKS_API_KEY=your_fireworks_key_here
OPENAI_API_KEY=your_openai_key_here

# ============================================================================
# Application Configuration
# ============================================================================
# Environment mode: development or production
NODE_ENV=development

# Claude Router API Key (for Bifrost gateway access)
# WARNING: Weak development default — change this in production!
ROUTER_API_KEY=dev-router-key

# ============================================================================
# Google Workspace MCP (optional — see .mcp.json)
# ============================================================================
# The google-workspace MCP server in .mcp.json expands these from your SHELL
# environment (export them in your shell profile), not from this file.
# Create an OAuth client in Google Cloud Console if you want Gmail access.
# GOOGLE_WORKSPACE_CLIENT_ID=your_google_oauth_client_id
# GOOGLE_WORKSPACE_CLIENT_SECRET=your_google_oauth_client_secret

# ============================================================================
# Optional: Keychain-backed secrets
# ============================================================================
# Tools may also read secrets from your OS keychain or a keychain-backed
# credential vault instead of this file; see global/integrations/ for the
# available clients and their setup notes.

# ============================================================================
# Optional: multi-account Cloudflare (tools/domain-registry)
# ============================================================================
# Comma-separated labels; for each label the domain-registry CLI reads a
# Keychain item named cloudflare-api-<label> (account: huxley). The list is
# read at import time — export it in your shell profile, not just before
# constructing the adapter.
# CLOUDFLARE_ACCOUNT_LABELS=personal,client-work

# ============================================================================
# Security Notes
# ============================================================================
# 1. Use strong passwords for POSTGRES_PASSWORD in production
# 2. Rotate API keys immediately if they are ever exposed in git history
# 3. Keep .env file permissions restricted (chmod 600 .env)
# 4. Never share .env file or commit it to version control
